{
  "factory_id": "electronics-factory-001",
  "factory_name": "Smart Device Electronics Factory",
  "factory_type": "electronics",
  "description": "High-volume electronics manufacturing for consumer devices",

  "machines": [
    {
      "machine_id": "pcb-assembly-01",
      "machine_type": "pcbassembly",
      "template_file": "machine-templates/pcb-assembly.json",
      "instance_name": "PCB Assembly Robot #1",
      "location": {"zone": "smt_line", "line": "assembly", "position": "A1"},
      "enabled": true
    },
    {
      "machine_id": "pcb-assembly-02",
      "machine_type": "pcbassembly",
      "template_file": "machine-templates/pcb-assembly.json",
      "instance_name": "PCB Assembly Robot #2",
      "location": {"zone": "smt_line", "line": "assembly", "position": "A2"},
      "enabled": true
    },
    {
      "machine_id": "soldering-01",
      "machine_type": "soldering",
      "template_file": "machine-templates/reflow-oven.json",
      "instance_name": "Reflow Oven #1",
      "location": {"zone": "smt_line", "line": "soldering", "position": "S1"},
      "enabled": true
    },
    {
      "machine_id": "testing-01",
      "machine_type": "testing",
      "template_file": "machine-templates/aoi-tester.json",
      "instance_name": "AOI Tester #1",
      "location": {"zone": "quality", "line": "testing", "position": "T1"},
      "enabled": true
    },
    {
      "machine_id": "testing-02",
      "machine_type": "testing",
      "template_file": "machine-templates/functional-tester.json",
      "instance_name": "Functional Tester #1",
      "location": {"zone": "quality", "line": "testing", "position": "T2"},
      "enabled": true
    },
    {
      "machine_id": "packaging-01",
      "machine_type": "packaging",
      "template_file": "machine-templates/electronics-packaging.json",
      "instance_name": "Automated Packager #1",
      "location": {"zone": "packaging", "line": "final", "position": "P1"},
      "enabled": true
    }
  ],

  "workflows": [
    {
      "workflow_id": "smartphone-pcb",
      "workflow_name": "Smartphone PCB Production",
      "product_type": "smartphone_pcb",
      "description": "Complete smartphone PCB assembly and testing",
      "steps": [
        {
          "step_id": "step-1a",
          "step_name": "Place CPU and RAM",
          "machine_type": "pcbassembly",
          "machine_id": "pcb-assembly-01",
          "operation": "place_component",
          "parameters": {
            "component": "cpu_ram_package",
            "position": "center"
          },
          "required_inputs": ["bare_pcb", "cpu_ram_package"],
          "outputs": ["pcb_with_cpu"],
          "parallel_group": 1,
          "timeout_seconds": 60
        },
        {
          "step_id": "step-1b",
          "step_name": "Place capacitors and resistors",
          "machine_type": "pcbassembly",
          "machine_id": "pcb-assembly-02",
          "operation": "place_component",
          "parameters": {
            "component": "passive_components",
            "position": "distributed"
          },
          "required_inputs": ["bare_pcb", "passive_components"],
          "outputs": ["pcb_with_passives"],
          "parallel_group": 1,
          "timeout_seconds": 90
        },
        {
          "step_id": "step-2",
          "step_name": "Reflow soldering",
          "machine_type": "soldering",
          "operation": "reflow",
          "parameters": {
            "profile": "lead_free",
            "peak_temperature": 245
          },
          "required_inputs": ["pcb_with_cpu", "pcb_with_passives"],
          "outputs": ["soldered_pcb"],
          "timeout_seconds": 300
        },
        {
          "step_id": "step-3",
          "step_name": "AOI inspection",
          "machine_type": "testing",
          "machine_id": "testing-01",
          "operation": "optical_inspect",
          "parameters": {
            "inspection_type": "full",
            "defect_threshold": 0.01
          },
          "required_inputs": ["soldered_pcb"],
          "outputs": ["inspected_pcb"],
          "timeout_seconds": 120,
          "conditions": [
            {
              "type": "quality",
              "expression": "solder_quality_score >= 0.95"
            }
          ]
        },
        {
          "step_id": "step-4",
          "step_name": "Functional testing",
          "machine_type": "testing",
          "machine_id": "testing-02",
          "operation": "functional_test",
          "parameters": {
            "test_suite": "smartphone_full",
            "test_duration": 60
          },
          "required_inputs": ["inspected_pcb"],
          "outputs": ["tested_pcb"],
          "timeout_seconds": 180
        },
        {
          "step_id": "step-5",
          "step_name": "ESD packaging",
          "machine_type": "packaging",
          "operation": "esd_package",
          "parameters": {
            "package_type": "anti_static_bag",
            "include_desiccant": true
          },
          "required_inputs": ["tested_pcb"],
          "outputs": ["packaged_pcb"],
          "timeout_seconds": 60
        }
      ],
      "metadata": {
        "estimated_time_minutes": 12,
        "complexity": "high",
        "quality_tier": "consumer_electronics",
        "cost_estimate": 45
      }
    },
    {
      "workflow_id": "iot-sensor",
      "workflow_name": "IoT Sensor Module Production",
      "product_type": "iot_sensor",
      "description": "Low-power IoT sensor module assembly",
      "steps": [
        {
          "step_id": "step-1",
          "step_name": "Place sensor and MCU",
          "machine_type": "pcbassembly",
          "operation": "place_component",
          "parameters": {
            "component": "sensor_mcu_combo"
          },
          "required_inputs": ["bare_pcb", "sensor_mcu_combo"],
          "outputs": ["pcb_with_components"],
          "timeout_seconds": 45
        },
        {
          "step_id": "step-2",
          "step_name": "Solder components",
          "machine_type": "soldering",
          "operation": "reflow",
          "parameters": {
            "profile": "low_temperature",
            "peak_temperature": 230
          },
          "required_inputs": ["pcb_with_components"],
          "outputs": ["soldered_sensor"],
          "timeout_seconds": 240
        },
        {
          "step_id": "step-3",
          "step_name": "Quick inspection",
          "machine_type": "testing",
          "operation": "optical_inspect",
          "parameters": {
            "inspection_type": "fast"
          },
          "required_inputs": ["soldered_sensor"],
          "outputs": ["inspected_sensor"],
          "timeout_seconds": 60
        },
        {
          "step_id": "step-4",
          "step_name": "Functional test",
          "machine_type": "testing",
          "operation": "functional_test",
          "parameters": {
            "test_suite": "iot_basic",
            "test_duration": 30
          },
          "required_inputs": ["inspected_sensor"],
          "outputs": ["tested_sensor"],
          "timeout_seconds": 90
        },
        {
          "step_id": "step-5",
          "step_name": "Package sensor",
          "machine_type": "packaging",
          "operation": "esd_package",
          "required_inputs": ["tested_sensor"],
          "outputs": ["packaged_sensor"],
          "timeout_seconds": 30
        }
      ],
      "metadata": {
        "estimated_time_minutes": 8,
        "complexity": "medium",
        "quality_tier": "iot_grade",
        "cost_estimate": 12
      }
    }
  ],

  "production_config": {
    "mode": "continuous",
    "target_rate": {
      "value": 500,
      "unit": "units_per_hour"
    },
    "shift_schedule": {
      "shifts_per_day": 2,
      "hours_per_shift": 10,
      "days_per_week": 6
    },
    "quality_control": {
      "enabled": true,
      "inspection_rate": 1.0,
      "rejection_threshold": 0.98
    },
    "inventory": {
      "enabled": true,
      "materials": [
        {
          "name": "bare_pcb",
          "initial_quantity": 50000,
          "reorder_point": 10000,
          "reorder_quantity": 40000,
          "unit": "units"
        },
        {
          "name": "cpu_ram_package",
          "initial_quantity": 10000,
          "reorder_point": 2000,
          "reorder_quantity": 8000,
          "unit": "units"
        },
        {
          "name": "passive_components",
          "initial_quantity": 500000,
          "reorder_point": 100000,
          "reorder_quantity": 400000,
          "unit": "units"
        },
        {
          "name": "solder_paste",
          "initial_quantity": 100,
          "reorder_point": 20,
          "reorder_quantity": 80,
          "unit": "kg"
        }
      ]
    },
    "performance_tracking": {
      "track_oee": true,
      "track_cycle_time": true,
      "track_downtime": true,
      "kpis": [
        {
          "name": "first_pass_yield",
          "formula": "passed_tests / total_tests * 100",
          "unit": "percent",
          "target": 99.5
        },
        {
          "name": "throughput",
          "formula": "completed_units / elapsed_hours",
          "unit": "units_per_hour",
          "target": 500
        },
        {
          "name": "defect_rate",
          "formula": "defective_units / total_units * 1000000",
          "unit": "dppm",
          "target": 100
        },
        {
          "name": "placement_accuracy_cpk",
          "formula": "1.67",
          "unit": "cpk",
          "target": 1.67
        }
      ]
    },
    "simulation": {
      "time_scale": 5.0,
      "randomness": 0.08,
      "enable_anomalies": true,
      "anomaly_frequency": 0.3
    }
  },

  "mqtt_config": {
    "broker": "mqttbroker",
    "port": 1883,
    "site_id": "electronics-factory-001",
    "topic_prefix": "factory",
    "qos": 1
  },

  "database_config": {
    "enabled": true,
    "type": "postgresql",
    "connection": {
      "host": "postgres",
      "port": 5432,
      "database": "electronics_factory",
      "user": "factory_user",
      "password": "factory_pass"
    }
  },

  "metadata": {
    "version": "1.0.0",
    "created_date": "2025-10-27T00:00:00Z",
    "author": "Factory Configuration Team",
    "tags": ["electronics", "smt", "pcb", "high_volume", "consumer_electronics"]
  }
}
