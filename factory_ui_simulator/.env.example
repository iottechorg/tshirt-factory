# Hugging Face Configuration for Image Generation
# Get your HF_TOKEN from https://huggingface.co/settings/tokens
# You need to have access to the FLUX.1-dev model
HF_TOKEN=your_huggingface_token_here

# Optional: Configure the image generation model and provider
# HF_MODEL=black-forest-labs/FLUX.1-dev
# HF_PROVIDER=together

# MQTT Configuration
MQTT_BROKER=tshirt-factory-001-mqtt
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_PUBLIC_HOST=localhost

# Flask web app
WEBAPP_PORT=5001

# Factory/Site Configuration
FACTORY_SITE_ID=tshirt-factory-001

# Machine Data Intervals (in seconds)
MACHINE_DATA_PUBLISH_INTERVAL=10
PRODUCTION_LOOP_INTERVAL=5
MACHINE_DATA_REST_REQUEST_INTERVAL=10

# Factory UI Integration
CUSTOMER_UI_URL=http://localhost:8080
CUSTOMER_UI_LABEL=designer

