{
  "factory_id": "tshirt-factory-001",
  "factory_name": "Smart T-Shirt Manufacturing Plant",
  "factory_type": "textile_tshirt",
  "description": "Complete t-shirt manufacturing facility with cutting, sewing, quality control, and packaging",
  "machines": [
    {
      "machine_id": "cutting-01",
      "machine_type": "cutting",
      "template_file": "machine-templates/cutting-machine.json",
      "instance_name": "Fabric Cutting Machine #1",
      "location": {
        "zone": "cutting_area",
        "line": "main_production",
        "position": "CUT-1"
      },
      "enabled": true,
      "config_overrides": {
        "sensors": {
          "blade_temperature": {
            "initial_value": 28.0
          }
        }
      }
    },
    {
      "machine_id": "sewing-01",
      "machine_type": "sewing",
      "template_file": "machine-templates/sewing-machine.json",
      "instance_name": "Industrial Sewing Machine #1",
      "location": {
        "zone": "sewing_area",
        "line": "main_production",
        "position": "SEW-1"
      },
      "enabled": true,
      "config_overrides": {
        "sensors": {
          "thread_tension": {
            "initial_value": 0.85
          }
        }
      }
    },
    {
      "machine_id": "qualitycheck-01",
      "machine_type": "qualitycheck",
      "template_file": "machine-templates/quality-check-machine.json",
      "instance_name": "AI Quality Inspector #1",
      "location": {
        "zone": "quality_control",
        "line": "main_production",
        "position": "QC-1"
      },
      "enabled": true,
      "config_overrides": {
        "sensors": {
          "defect_detection_rate": {
            "initial_value": 0.975
          }
        }
      }
    },
    {
      "machine_id": "packaging-01",
      "machine_type": "packaging",
      "template_file": "machine-templates/packaging-machine.json",
      "instance_name": "Automated Packaging System #1",
      "location": {
        "zone": "packaging_area",
        "line": "main_production",
        "position": "PKG-1"
      },
      "enabled": true,
      "config_overrides": {
        "sensors": {
          "label_dispenser_level": {
            "initial_value": 90.0
          }
        }
      }
    }
  ],
  "workflows": [
    {
      "workflow_id": "standard-tshirt-production",
      "workflow_name": "Standard T-Shirt Production",
      "product_type": "tshirt",
      "description": "Complete t-shirt manufacturing workflow from cutting to packaging",
      "steps": [
        {
          "step_id": "step-1",
          "step_name": "Cut fabric pieces",
          "machine_type": "cutting",
          "operation": "cut_fabric",
          "parameters": {
            "material": "cotton",
            "cut_size": "M"
          },
          "required_inputs": [
            "fabric_roll"
          ],
          "outputs": [
            "cut_pieces"
          ],
          "timeout_seconds": 30,
          "retry": {
            "enabled": true,
            "max_attempts": 2,
            "delay_seconds": 5
          }
        },
        {
          "step_id": "step-2",
          "step_name": "Sew t-shirt pieces",
          "machine_type": "sewing",
          "operation": "sew_pieces",
          "parameters": {
            "stitch_type": "standard"
          },
          "required_inputs": [
            "cut_pieces"
          ],
          "outputs": [
            "sewn_tshirt"
          ],
          "timeout_seconds": 45,
          "retry": {
            "enabled": true,
            "max_attempts": 2,
            "delay_seconds": 10
          }
        },
        {
          "step_id": "step-3",
          "step_name": "Quality inspection",
          "machine_type": "qualitycheck",
          "operation": "inspect_quality",
          "required_inputs": [
            "sewn_tshirt"
          ],
          "outputs": [
            "inspected_tshirt",
            "quality_report"
          ],
          "timeout_seconds": 20,
          "conditions": [
            {
              "type": "quality",
              "expression": "inspection_score >= 85",
              "on_failure": "retry"
            }
          ],
          "retry": {
            "enabled": true,
            "max_attempts": 1,
            "delay_seconds": 5
          }
        },
        {
          "step_id": "step-4",
          "step_name": "Package t-shirt",
          "machine_type": "packaging",
          "operation": "package_tshirt",
          "parameters": {
            "packaging_type": "standard"
          },
          "required_inputs": [
            "inspected_tshirt"
          ],
          "outputs": [
            "packaged_tshirt",
            "package_label"
          ],
          "timeout_seconds": 30,
          "retry": {
            "enabled": true,
            "max_attempts": 2,
            "delay_seconds": 5
          }
        }
      ],
      "metadata": {
        "estimated_time_minutes": 5,
        "complexity": "medium",
        "quality_tier": "standard",
        "cost_estimate": 8.5
      }
    },
    {
      "workflow_id": "premium-tshirt-production",
      "workflow_name": "Premium T-Shirt Production",
      "product_type": "premium_tshirt",
      "description": "Premium t-shirt with enhanced quality control and packaging",
      "steps": [
        {
          "step_id": "step-1",
          "step_name": "Cut premium fabric",
          "machine_type": "cutting",
          "operation": "cut_fabric",
          "parameters": {
            "material": "organic_cotton",
            "cut_size": "L"
          },
          "required_inputs": [
            "premium_fabric_roll"
          ],
          "outputs": [
            "cut_pieces"
          ],
          "timeout_seconds": 30
        },
        {
          "step_id": "step-2",
          "step_name": "Precision sewing",
          "machine_type": "sewing",
          "operation": "sew_pieces",
          "parameters": {
            "stitch_type": "reinforced"
          },
          "required_inputs": [
            "cut_pieces"
          ],
          "outputs": [
            "sewn_tshirt"
          ],
          "timeout_seconds": 60
        },
        {
          "step_id": "step-3",
          "step_name": "Detailed quality inspection",
          "machine_type": "qualitycheck",
          "operation": "detailed_inspection",
          "required_inputs": [
            "sewn_tshirt"
          ],
          "outputs": [
            "inspected_tshirt",
            "detailed_report"
          ],
          "timeout_seconds": 45,
          "conditions": [
            {
              "type": "quality",
              "expression": "inspection_score >= 95",
              "on_failure": "reject"
            }
          ]
        },
        {
          "step_id": "step-4",
          "step_name": "Premium packaging",
          "machine_type": "packaging",
          "operation": "package_tshirt",
          "parameters": {
            "packaging_type": "premium"
          },
          "required_inputs": [
            "inspected_tshirt"
          ],
          "outputs": [
            "packaged_tshirt",
            "package_label"
          ],
          "timeout_seconds": 40
        }
      ],
      "metadata": {
        "estimated_time_minutes": 8,
        "complexity": "high",
        "quality_tier": "premium",
        "cost_estimate": 15.0
      }
    },
    {
      "workflow_id": "custom-print-tshirt",
      "workflow_name": "Custom Printed T-Shirt",
      "product_type": "custom_tshirt",
      "description": "T-shirt with custom text/design printing",
      "steps": [
        {
          "step_id": "step-1",
          "step_name": "Cut fabric",
          "machine_type": "cutting",
          "operation": "cut_fabric",
          "parameters": {
            "material": "cotton",
            "cut_size": "M"
          },
          "required_inputs": [
            "fabric_roll"
          ],
          "outputs": [
            "cut_pieces"
          ],
          "timeout_seconds": 30
        },
        {
          "step_id": "step-2",
          "step_name": "Sew pieces",
          "machine_type": "sewing",
          "operation": "sew_pieces",
          "required_inputs": [
            "cut_pieces"
          ],
          "outputs": [
            "sewn_tshirt"
          ],
          "timeout_seconds": 45
        },
        {
          "step_id": "step-3",
          "step_name": "Pre-print inspection",
          "machine_type": "qualitycheck",
          "operation": "inspect_quality",
          "required_inputs": [
            "sewn_tshirt"
          ],
          "outputs": [
            "inspected_tshirt"
          ],
          "timeout_seconds": 20,
          "conditions": [
            {
              "type": "quality",
              "expression": "inspection_score >= 90"
            }
          ]
        },
        {
          "step_id": "step-4",
          "step_name": "Package custom t-shirt",
          "machine_type": "packaging",
          "operation": "package_tshirt",
          "parameters": {
            "packaging_type": "gift"
          },
          "required_inputs": [
            "inspected_tshirt"
          ],
          "outputs": [
            "packaged_tshirt"
          ],
          "timeout_seconds": 35
        }
      ],
      "metadata": {
        "estimated_time_minutes": 7,
        "complexity": "medium",
        "quality_tier": "custom",
        "cost_estimate": 12.0
      }
    }
  ],
  "production_config": {
    "mode": "on-demand",
    "target_rate": {
      "value": 100,
      "unit": "tshirts_per_day"
    },
    "shift_schedule": {
      "shifts_per_day": 2,
      "hours_per_shift": 8,
      "days_per_week": 6
    },
    "quality_control": {
      "enabled": true,
      "inspection_rate": 1.0,
      "rejection_threshold": 0.95,
      "rework_enabled": true,
      "quarantine_enabled": true
    },
    "inventory": {
      "enabled": true,
      "materials": [
        {
          "name": "fabric_roll",
          "type": "cotton",
          "initial_quantity": 500,
          "reorder_point": 100,
          "reorder_quantity": 400,
          "unit": "meters"
        },
        {
          "name": "premium_fabric_roll",
          "type": "organic_cotton",
          "initial_quantity": 200,
          "reorder_point": 40,
          "reorder_quantity": 160,
          "unit": "meters"
        },
        {
          "name": "thread",
          "initial_quantity": 1000,
          "reorder_point": 200,
          "reorder_quantity": 800,
          "unit": "spools"
        },
        {
          "name": "labels",
          "initial_quantity": 5000,
          "reorder_point": 1000,
          "reorder_quantity": 4000,
          "unit": "pieces"
        },
        {
          "name": "poly_bags",
          "initial_quantity": 3000,
          "reorder_point": 500,
          "reorder_quantity": 2500,
          "unit": "pieces"
        }
      ]
    },
    "performance_tracking": {
      "track_oee": true,
      "track_cycle_time": true,
      "track_downtime": true,
      "kpis": [
        {
          "name": "production_throughput",
          "formula": "completed_tshirts / elapsed_hours",
          "unit": "tshirts_per_hour",
          "target": 12.5
        },
        {
          "name": "first_pass_yield",
          "formula": "(completed_tshirts - rework_items) / completed_tshirts * 100",
          "unit": "percentage",
          "target": 95.0
        },
        {
          "name": "quality_pass_rate",
          "formula": "passed_inspections / total_inspections * 100",
          "unit": "percentage",
          "target": 97.0
        },
        {
          "name": "average_cycle_time",
          "formula": "sum(workflow_durations) / count(workflows)",
          "unit": "minutes",
          "target": 5.0
        },
        {
          "name": "machine_utilization",
          "formula": "sum(machine_active_time) / sum(machine_available_time) * 100",
          "unit": "percentage",
          "target": 85.0
        },
        {
          "name": "defect_rate",
          "formula": "rejected_items / total_items * 100",
          "unit": "percentage",
          "target": 3.0
        }
      ]
    },
    "simulation": {
      "time_scale": 10.0,
      "randomness": 0.08,
      "enable_anomalies": true,
      "anomaly_frequency": 0.2
    }
  },
  "mqtt_config": {
    "broker": "mqttbroker",
    "port": 1883,
    "site_id": "tshirt-factory-001",
    "topic_prefix": "factory",
    "qos": 1,
    "websocket_port": 9001
  },
  "database_config": {
    "enabled": true,
    "type": "postgresql",
    "connection": {
      "host": "postgres",
      "port": 5432,
      "database": "tshirt_factory",
      "user": "factory_user",
      "password": "factory_pass"
    }
  },
  "metadata": {
    "version": "1.0.0",
    "created_date": "2025-10-27T00:00:00Z",
    "author": "Factory Configuration Team",
    "tags": [
      "tshirt",
      "textile",
      "garment",
      "manufacturing",
      "ecommerce"
    ],
    "compatible_frontends": [
      "tshirt-customizer",
      "simple_factory_simulator"
    ],
    "notes": "This factory configuration replaces the hardcoded services/ implementation with JSON-driven generated code"
  }
}