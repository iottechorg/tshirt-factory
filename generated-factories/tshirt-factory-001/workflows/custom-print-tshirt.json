{
  "workflow_id": "custom-print-tshirt",
  "workflow_name": "Custom Printed T-Shirt",
  "product_type": "custom_tshirt",
  "description": "T-shirt with custom text/design printing",
  "steps": [
    {
      "step_id": "step-1",
      "step_name": "Cut fabric",
      "machine_type": "cutting",
      "operation": "cut_fabric",
      "parameters": {
        "material": "cotton",
        "cut_size": "M"
      },
      "required_inputs": [
        "fabric_roll"
      ],
      "outputs": [
        "cut_pieces"
      ],
      "timeout_seconds": 30
    },
    {
      "step_id": "step-2",
      "step_name": "Sew pieces",
      "machine_type": "sewing",
      "operation": "sew_pieces",
      "required_inputs": [
        "cut_pieces"
      ],
      "outputs": [
        "sewn_tshirt"
      ],
      "timeout_seconds": 45
    },
    {
      "step_id": "step-3",
      "step_name": "Pre-print inspection",
      "machine_type": "qualitycheck",
      "operation": "inspect_quality",
      "required_inputs": [
        "sewn_tshirt"
      ],
      "outputs": [
        "inspected_tshirt"
      ],
      "timeout_seconds": 20,
      "conditions": [
        {
          "type": "quality",
          "expression": "inspection_score >= 90"
        }
      ]
    },
    {
      "step_id": "step-4",
      "step_name": "Package custom t-shirt",
      "machine_type": "packaging",
      "operation": "package_tshirt",
      "parameters": {
        "packaging_type": "gift"
      },
      "required_inputs": [
        "inspected_tshirt"
      ],
      "outputs": [
        "packaged_tshirt"
      ],
      "timeout_seconds": 35
    }
  ],
  "metadata": {
    "estimated_time_minutes": 7,
    "complexity": "medium",
    "quality_tier": "custom",
    "cost_estimate": 12.0
  }
}