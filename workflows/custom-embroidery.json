{
  "workflow_id": "workflow-custom-embroidery",
  "workflow_name": "Custom Embroidery Production",
  "description": "T-shirt with custom embroidery instead of printing",
  "product_type": "tshirt-embroidery",
  "steps": [
    {
      "step_id": "step-1",
      "machine_type": "cutting",
      "operation": "cut_fabric",
      "required_inputs": ["material", "cut_size"],
      "optional_inputs": [],
      "outputs": ["cut_fabric"],
      "parallel_group": null,
      "timeout_seconds": 60,
      "retry_count": 0
    },
    {
      "step_id": "step-2",
      "machine_type": "sewing",
      "operation": "sew_basic",
      "required_inputs": ["cut_fabric", "stitch_type", "thread_color"],
      "optional_inputs": [],
      "outputs": ["sewn_basic"],
      "parallel_group": null,
      "timeout_seconds": 60,
      "retry_count": 0
    },
    {
      "step_id": "step-3",
      "machine_type": "sewing",
      "operation": "add_embroidery",
      "required_inputs": ["sewn_basic", "thread_color"],
      "optional_inputs": ["design_name"],
      "outputs": ["embroidered_garment"],
      "parallel_group": null,
      "timeout_seconds": 90,
      "retry_count": 0
    },
    {
      "step_id": "step-4",
      "machine_type": "ironing",
      "operation": "final_press",
      "required_inputs": ["embroidered_garment", "iron_temperature_setpoint", "steam_level"],
      "optional_inputs": [],
      "outputs": ["finished_product"],
      "parallel_group": null,
      "timeout_seconds": 60,
      "retry_count": 0
    }
  ],
  "metadata": {
    "estimated_time_minutes": 30,
    "complexity": "custom"
  }
}
